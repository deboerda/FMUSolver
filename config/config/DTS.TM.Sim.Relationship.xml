<!--仿真-遥测对应关系-->
<Config>
    <InitialFlagVar>Is_initial</InitialFlagVar>
    <TTCFlagVar>CK01</TTCFlagVar>
    <DevInitTableVar>IniLoad_Online</DevInitTableVar>
    <!--每个航天器包括设备和全局变量两部分-->
    <!--IniLoadInput：负载设备在模型中的input变量，是一个三维数组-->
    <Sat name="梦天舱">
        <Subsys name="GNC">
            <!--设备Device包含多个模块Module，单个模块对应一个遥测值，遥测取值在不同工作模式对应模块的不同功耗，设备的功耗等于其所有模块功耗的和-->
            <!--distributor：负载所属配电器-->
            <!--line：:负载在所属配电器的第几路-->
            <!--init_var:表示是否只在仿真初始化时注入，若为true只会在仿真开始或手动选择天地状态同步时注入，否则每个单步注入-->
            <Device init_var="true" line="4" name="红外地球敏感器1" distributor="9">
                <Module def_powerload="0" expression="#(TGMTC101.DAHE@VGKH21)">
                    <Interval range="[0,0.5]" powerload="0"/>
                    <Interval range="[2.5,4.5]" powerload="7"/>
                </Module>
            </Device>
        </Subsys>
        <GlobalVars>
            <Category name="姿轨控">
